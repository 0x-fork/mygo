// The window's edges glowing while the assistant works, as Siri lights
// the screen's: the window's outline stroked, inside its edge, with an
// angular gradient of six colors around the window's middle whose stops
// move about (wrapping around), in four layers: a crisp line 6 DIPs wide, and lines 9, 11
// and 15 wide blurred by 4, 12 and 15, as SwiftUI blurs; as it starts, a
// wave of light runs in from the edges and fades.

// Stops are the gradient's stops in order: a color (rgb) and where it
// lies around the window from 0 to 1 (a), clockwise from the right.
var Stops [6]vec4

// Strength is how much it shows, from 0 to 1.
var Strength float
// Burst is the seconds since it started.
var Burst float
// Corner is the window's corner radius, in DIPs.
var Corner float

// gradient returns the gradient's color at t, around the window from 0 to
// 1: the colors between the stops, and between the last and the first
// across the start, where SwiftUI's AngularGradient would show a seam.
func gradient(t float) vec3 {
	first, last := Stops[0], Stops[5]
	span := first.a + 1 - last.a
	if t < first.a {
		return mix(last.rgb, first.rgb, (t+1-last.a)/max(span, 0.0001))
	}
	c := last.rgb
	if t >= last.a {
		return mix(last.rgb, first.rgb, (t-last.a)/max(span, 0.0001))
	}
	for i := 1; i < 6; i++ {
		a, b := Stops[i-1], Stops[i]
		if t >= a.a && t < b.a {
			c = mix(a.rgb, b.rgb, (t-a.a)/max(b.a-a.a, 0.0001))
		}
	}
	return c
}

func erf(x float) float {
	x2 := x * x
	return sign(x) * sqrt(1-exp(-x2*(1.2732395+0.147*x2)/(1+0.147*x2)))
}

// line returns how much of a line width DIPs wide, inside the edge, d
// DIPs in, covers once blurred as SwiftUI blurs by radius.
func line(d, width, radius float) float {
	if radius == 0 {
		return clamp(width-d+0.5, 0, 1)
	}
	s := radius * 1.4142136
	return 0.5 * (erf((width-d)/s) + erf(d/s))
}

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	p := pos - 0.5*size
	// How far in from the edge, round in the corners, as a blur rounds
	// them.
	d := min(max(-roundRect(p, 0.5*size, Corner), 0), inside(p, size))
	wave := 0.0
	if Burst < 3 {
		front := 320 * (1 - exp(-Burst*2.2))
		x := (inside(p, size) - front) / (26 + 80*Burst)
		wave = exp(-x*x) * exp(-Burst*1.7) * 0.45
	}
	if d > 70 && wave < 0.002 {
		return vec4(0)
	}
	// The layers, one over another, in one color.
	clear := (1 - line(d, 6, 0)) * (1 - line(d, 9, 4)) * (1 - line(d, 11, 12)) * (1 - line(d, 15, 15)) * (1 - wave)
	alpha := (1 - clear) * Strength
	t := fract(atan2(p.y, p.x) / 6.2831853)
	return vec4(gradient(t)*alpha, alpha)
}
