// The window's edges glowing while the assistant works, as Siri lights
// the screen's: a thick band of saturated light hugging the edges, its
// colors flowing around them and hot spots travelling along it, white at
// the rim where they burn brightest, over a haze reaching in; as it
// starts, a wave of light runs in from the edges and fades.

var Time float
// Strength is how much it shows, from 0 to 1.
var Strength float
// Burst is the seconds since it started.
var Burst float
// Corner is the window's corner radius, in DIPs.
var Corner float
// Dark is 1 on a dark theme, where the glow adds light, and 0 on a light
// one, where it covers what is under it.
var Dark float

// spots returns how bright the light is at a, around the edges from 0 to
// 1: hot spots travelling both ways at their own speeds, swelling and
// fading.
func spots(a float) float {
	s := 0.0
	for i := 0; i < 5; i++ {
		f := float(i)
		dir := 1.0
		if i%2 == 1 {
			dir = -1
		}
		c := fract(f*0.23 + dir*Time*(0.06+0.025*f))
		x := abs(a - c)
		x = min(x, 1-x)
		w := 0.07 + 0.03*sin(Time*0.9+f*1.7)
		s += exp(-x*x/(w*w)) * (0.6 + 0.4*sin(Time*1.3+f*2.4))
	}
	return s
}

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	p := pos - 0.5*size
	d := max(-roundRect(p, 0.5*size, Corner), 0)
	soft := min(inside(p, size), d+40)
	if soft > 360 && Burst > 3 {
		return vec4(0)
	}
	a := around(p, size)
	hot := spots(a)
	breathe := 0.9 + 0.1*sin(Time*2.1)
	// A thick band of light, its rim brightest, a haze reaching in.
	width := 42 * breathe
	band := exp(-pow(soft/width, 1.4)) * (0.8 + 0.4*min(hot, 1.5))
	rim := exp(-d / 3)
	haze := exp(-soft/95) * 0.35
	wave := 0.0
	if Burst < 3 {
		front := 320 * (1 - exp(-Burst*2.2))
		w := 26 + 80*Burst
		x := (soft - front) / w
		wave = exp(-x*x) * exp(-Burst*1.7) * 0.8
	}
	flow := a + Time*0.09
	// The colors flow around the edges, a little later further in.
	c := palette(flow + 0.06*soft/width)
	c = clamp(mix(vec3(dot(c, vec3(0.3, 0.55, 0.15))), c, 1.35), 0, 1)
	light := band + rim + haze + wave
	col := c*(band+haze)*mix(1, 1.3, Dark) + palette(flow+0.1)*rim + palette(flow+0.4)*wave
	// White where it burns brightest, at the edge's hot spots.
	col += vec3(1) * rim * max(hot-0.6, 0) * 0.7
	strength := Strength * (0.92 + 0.08*sin(Time*2.1+1))
	col *= strength
	alpha := clamp(light*strength, 0, 1)
	// On a dark theme the glow adds light; on a light one it covers.
	alpha *= mix(1, 0.6, Dark)
	return vec4(min(col, max(alpha, Dark)), alpha)
}
