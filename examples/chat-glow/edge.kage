// The window's edges glowing while the assistant works: a fine bright
// line, a glow and a wide haze, their colors flowing around the window and
// swelling here and there; as it starts, a wave of light runs in from the
// edges and fades.

var Time float
// Strength is how much it shows, from 0 to 1.
var Strength float
// Burst is the seconds since it started.
var Burst float
// Corner is the window's corner radius, in DIPs.
var Corner float

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	p := pos - 0.5*size
	d := -roundRect(p, 0.5*size, Corner)
	soft := min(inside(p, size), d+40)
	if soft > 320 && Burst > 3 {
		return vec4(0)
	}
	a := around(p, size)
	flow := a + Time*0.07 + 0.05*sin(a*6.2831853*3-Time*1.3)
	swell := 0.55 + 0.45*sin(a*6.2831853*2+Time*1.7)*sin(a*6.2831853*3-Time*1.1+1)

	line := exp(-d / 1.3)
	glow := exp(-d / 14)
	haze := exp(-soft/55) * swell
	wave := 0.0
	if Burst < 3 {
		front := 300 * (1 - exp(-Burst*2.4))
		width := 22 + 70*Burst
		x := (soft - front) / width
		wave = exp(-x*x) * exp(-Burst*1.8) * 0.6
	}
	wl, wg, wh, ww := line, glow*0.85, haze*0.6, wave
	alpha := clamp(wl+wg+wh+ww, 0, 1) * Strength
	col := (palette(flow)*wl + palette(flow+0.12)*wg + palette(flow+0.27)*wh + palette(flow+0.45)*ww) / max(wl+wg+wh+ww, 0.0001)
	return vec4(col*alpha, alpha)
}
