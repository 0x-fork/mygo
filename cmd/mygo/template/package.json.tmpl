{
  "name": "{{.Slug}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "{{.Mygo}} dev",
    "build": "{{.Mygo}} build",
    "generate": "{{.Mygo}} generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mygo-runtime": "{{.Runtime}}"
  },
  "devDependencies": {
{{- if .CLI}}
    "mygo-cli": "{{.CLI}}",
{{- end}}
    "typescript": "^7",
    "vite": "^8"
  }
}
